<body class="j-body">
    <div class="wrapper">
      <div class="form-signin">
        <h2 class="form-signin-heading">Login to Renewable Energy</h2>
        <%= button_to auth_path(provider: 'github'), method: :post,
            params: { redirect_user_url: @redirect_user_url },
            class: "btn btn-block btn-social btn-github" do %>
          <span class="fa fa-github"></span>Sign in with Github
        <% end %>
        <%= button_to auth_path(provider: 'facebook'), method: :post,
            params: { redirect_user_url: @redirect_user_url },
            class: "btn btn-block btn-social btn-facebook" do %>
          <span class="fa fa-facebook"></span>Sign in with Facebook
        <% end %>
        <%= button_to auth_path(provider: 'twitter'), method: :post,
            params: { redirect_user_url: @redirect_user_url },
            class: "btn btn-block btn-social btn-twitter" do %>
          <span class="fa fa-twitter"></span>Sign in with Twitter
        <% end %>
        <%= button_to auth_path(provider: 'google'), method: :post,
            params: { redirect_user_url: @redirect_user_url },
            class: "btn btn-block btn-social btn-google" do %>
          <span class="fa fa-google"></span>Sign in with Google
        <% end %>
      </div>
    </div>
  </body>
